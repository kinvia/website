---
import { type Locale, getDictionary } from '../i18n';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const h = dict.hero;
---

<section id={dict.nav.anchors.hero} data-section="hero" class="hero-plane" tabindex="-1" aria-labelledby="hero-heading">
  <div class="container">
    <div class="hero-inner">
      <div class="hero-brand-mark">
        <img
          src="/images/logo-w.webp"
          alt="Kinvia"
          width="240"
          height="79"
          fetchpriority="high"
          loading="eager"
          decoding="async"
          class="hero-logo"
        />
        <span class="section-eyebrow">{h.eyebrow}</span>
      </div>

      <h1 id="hero-heading" class="hero-claim">{h.claim}</h1>
      <p class="hero-subtitle">{h.subtitle}</p>
      <p class="hero-lead">{h.lead}</p>

      <div class="hero-actions">
        <a href={`#${dict.nav.anchors.contact}`} class="btn-primary">{h.cta}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero-plane {
    position: relative;
    min-height: calc(86vh - 4.5rem);
    display: flex;
    align-items: center;
    padding: 5.5rem 0;
    border-bottom: 1px solid var(--border-subtle);
    background:
      radial-gradient(circle at 82% 18%, var(--accent-tech-muted), transparent 46%),
      linear-gradient(180deg, var(--bg-primary) 0%, var(--bg-elevated) 100%);
  }

  .hero-inner {
    max-width: 900px;
    animation: heroEntrance var(--transition-med) both;
  }

  .hero-brand-mark {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.75rem;
  }

  .hero-logo {
    height: auto;
    max-width: 210px;
    display: block;
  }

  :global([data-theme="light"]) .hero-logo {
    filter: invert(1) hue-rotate(180deg);
  }

  .hero-claim {
    font-size: clamp(2.35rem, 5vw, 4rem);
    font-weight: 800;
    margin-bottom: 1.25rem;
    letter-spacing: -0.03em;
  }

  .hero-subtitle {
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    font-weight: 600;
    color: var(--accent-tech-strong);
    margin-bottom: 1rem;
  }

  .hero-lead {
    font-size: 1.125rem;
    color: var(--text-secondary);
    max-width: 64ch;
    margin-bottom: 2.5rem;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  @keyframes heroEntrance {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
