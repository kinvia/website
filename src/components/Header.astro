---
import { type Locale, getDictionary, getAlternatePath } from '../i18n';

export interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;
const dict = getDictionary(locale);
const otherLocale: Locale = locale === 'es' ? 'en' : 'es';
const altPath = getAlternatePath(otherLocale, currentPath);
const homePrefix = `/${locale}/`;
---

<header class="site-header" role="banner">
  <div class="container header-inner">
    <a href={homePrefix} class="brand-link" aria-label="Kinvia">
      <img
        src="/images/logo-w.webp"
        alt="Kinvia"
        width="136"
        height="45"
        class="brand-logo brand-logo-dark"
      />
      <img
        src="/images/logo.webp"
        alt="Kinvia"
        width="136"
        height="53"
        class="brand-logo brand-logo-light"
      />
    </a>

    <nav class="primary-nav" aria-label={locale === 'es' ? 'Navegación principal' : 'Primary navigation'}>
      <ul class="nav-list">
        <li><a href={`${homePrefix}#${dict.nav.anchors.hero}`}>{dict.nav.hero}</a></li>
        <li><a href={`${homePrefix}#${dict.nav.anchors.axes}`}>{dict.nav.axes}</a></li>
        <li><a href={`${homePrefix}#${dict.nav.anchors.services}`}>{dict.nav.services}</a></li>
        <li><a href={`${homePrefix}#${dict.nav.anchors.model}`}>{dict.nav.model}</a></li>
        <li><a href={`${homePrefix}#${dict.nav.anchors.contact}`}>{dict.nav.contact}</a></li>
      </ul>
    </nav>

    <div class="header-actions">
      <a
        href={altPath}
        class="lang-switch"
        aria-label={dict.nav.langSwitchLabel}
        hreflang={otherLocale}
        data-lang-switch
        data-base-href={altPath}
        data-target-locale={otherLocale}
      >
        {dict.nav.langCode}
      </a>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    if (typeof window === 'undefined') return;

    var HASH_MAP = {
      es: {
        inicio: 'inicio',
        divisiones: 'divisiones',
        servicios: 'servicios',
        modelos: 'modelos',
        contacto: 'contacto',
        hero: 'inicio',
        axes: 'divisiones',
        services: 'servicios',
        model: 'modelos',
        contact: 'contacto',
      },
      en: {
        inicio: 'hero',
        divisiones: 'axes',
        servicios: 'services',
        modelos: 'model',
        contacto: 'contact',
        hero: 'hero',
        axes: 'axes',
        services: 'services',
        model: 'model',
        contact: 'contact',
      },
    };

    function syncLangSwitchers(rawAnchor) {
      var clean = (rawAnchor || '').replace(/^#/, '');
      if (!clean) return;
      var switchers = document.querySelectorAll('[data-lang-switch]');
      switchers.forEach(function (sw) {
        var baseHref = sw.getAttribute('data-base-href') || sw.getAttribute('href') || '/';
        var cleanBase = baseHref.split('#')[0];
        var targetLocale = sw.getAttribute('data-target-locale') || 'es';
        var map = HASH_MAP[targetLocale] || HASH_MAP.es;
        var translated = map[clean];
        if (translated) {
          sw.setAttribute('href', cleanBase + '#' + translated);
        }
      });
    }

    function initScrollSpy() {
      var links = document.querySelectorAll('.nav-list a[href*="#"]');
      var sectionNodes = document.querySelectorAll('main section[id], section[data-section]');
      var sections = Array.prototype.slice.call(sectionNodes);

      if (!sections.length) {
        var fallbackIds = [
          'inicio',
          'divisiones',
          'servicios',
          'modelos',
          'contacto',
          'hero',
          'axes',
          'services',
          'model',
          'contact',
        ];
        sections = fallbackIds
          .map(function (id) {
            return document.getElementById(id);
          })
          .filter(Boolean);
      }

      if (window.location.hash) {
        syncLangSwitchers(window.location.hash);
      }

      if (!links.length || !sections.length) return;

      function setActive(id) {
        links.forEach(function (link) {
          var href = link.getAttribute('href') || '';
          var match = href.indexOf('#' + id) !== -1;
          if (match) {
            link.classList.add('is-active');
            link.setAttribute('aria-current', 'location');
          } else {
            link.classList.remove('is-active');
            link.removeAttribute('aria-current');
          }
        });
        syncLangSwitchers(id);
      }

      function computeActiveSection() {
        var viewportHeight = window.innerHeight || document.documentElement.clientHeight || 800;
        var scrollBottom = (window.scrollY || window.pageYOffset || 0) + viewportHeight;
        var docHeight = document.documentElement.scrollHeight || 0;

        if (docHeight > 0 && scrollBottom >= docHeight - 40) {
          setActive(sections[sections.length - 1].id);
          return;
        }

        var threshold = viewportHeight * 0.35;
        var activeId = sections[0].id;

        for (var i = 0; i < sections.length; i++) {
          var rect = sections[i].getBoundingClientRect();
          if (rect.top <= threshold) {
            activeId = sections[i].id;
          }
        }

        setActive(activeId);
      }

      if ('IntersectionObserver' in window) {
        var observer = new IntersectionObserver(
          function () {
            computeActiveSection();
          },
          {
            rootMargin: '-15% 0px -55% 0px',
            threshold: [0, 0.25, 0.5, 1],
          }
        );
        sections.forEach(function (sec) {
          observer.observe(sec);
        });
      }

      window.addEventListener('scroll', computeActiveSection, { passive: true });
      window.addEventListener('resize', computeActiveSection, { passive: true });
      window.addEventListener('hashchange', function () {
        if (window.location.hash) {
          var hashId = window.location.hash.replace(/^#/, '');
          setActive(hashId);
        } else {
          computeActiveSection();
        }
      });

      links.forEach(function (link) {
        link.addEventListener('click', function () {
          var href = link.getAttribute('href') || '';
          var hashIdx = href.indexOf('#');
          if (hashIdx !== -1) {
            setActive(href.slice(hashIdx + 1));
          }
        });
      });

      if (window.location.hash) {
        setActive(window.location.hash.replace(/^#/, ''));
      } else {
        computeActiveSection();
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initScrollSpy);
    } else {
      initScrollSpy();
    }
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: var(--bg-glass);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border-subtle);
    width: 100%;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.5rem;
    gap: 1.25rem;
    width: 100%;
  }

  .brand-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;
  }

  .brand-logo {
    height: 2.25rem;
    width: auto;
    display: block;
  }

  .brand-logo-light {
    display: none;
  }

  :global([data-theme="light"]) .brand-logo-dark {
    display: none;
  }

  :global([data-theme="light"]) .brand-logo-light {
    display: block;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    list-style: none;
  }

  .nav-list a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    font-size: 0.95rem;
    border-bottom: 2px solid transparent;
    padding-bottom: 0.25rem;
    transition: color var(--transition-fast), border-color var(--transition-fast);
  }

  .nav-list a:hover {
    color: var(--accent-tech-strong);
  }

  .nav-list a.is-active,
  .nav-list a[aria-current="location"] {
    color: var(--accent-tech-strong);
    font-weight: 700;
    border-bottom-color: var(--accent-tech-strong);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 700;
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    text-decoration: none;
  }

  .lang-switch:hover {
    border-color: var(--accent-tech-strong);
    color: var(--accent-tech-strong);
  }

  @media (max-width: 768px) {
    .primary-nav {
      display: none;
    }
  }
</style>
