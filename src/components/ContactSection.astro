---
import { type Locale, getDictionary } from '../i18n';
import { ContactForm } from './ContactForm';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = getDictionary(locale);
const c = dict.contact;
---

<section id={dict.nav.anchors.contact} data-section="contact" class="section-shell contact-section" tabindex="-1" aria-labelledby="contact-heading">
  <div class="container contact-grid">
    <div class="contact-info">
      <span class="section-eyebrow">{c.eyebrow}</span>
      <h2 id="contact-heading" class="section-title">{c.title}</h2>
      <p class="section-subtitle">{c.subtitle}</p>

      <dl class="direct-channels">
        <div class="channel-item">
          <dt>{c.emailLabel}</dt>
          <dd>
            <a href={`mailto:${c.email}`} class="channel-link">{c.email}</a>
          </dd>
        </div>

        <div class="channel-item">
          <dt>{c.phoneLabel}</dt>
          <dd>
            <a href={c.phoneHref} class="channel-link">{c.phone}</a>
          </dd>
        </div>

        <div class="channel-item">
          <dt>{c.locationLabel}</dt>
          <dd>{c.location}</dd>
        </div>
      </dl>
    </div>

    <div class="contact-form-wrapper">
      <ContactForm client:visible locale={locale} copy={c.form} />
    </div>
  </div>
</section>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 3.5rem;
    align-items: start;
  }

  .direct-channels {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-subtle);
  }

  .channel-item dt {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 0.25rem;
  }

  .channel-item dd {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .channel-link {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--accent-tech-strong);
    text-decoration: none;
  }

  .channel-link:hover {
    text-decoration: underline;
  }

  :global(.contact-form-card) {
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 2.25rem;
    box-shadow: var(--shadow-elevated);
  }

  :global(.kinvia-form) {
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
  }

  :global(.form-field) {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }

  :global(.form-field label) {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-primary);
  }

  :global(.form-field input),
  :global(.form-field textarea) {
    width: 100%;
    padding: 0.8rem 1rem;
    background-color: var(--bg-primary);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: 1rem;
  }

  :global(.form-field input:focus),
  :global(.form-field textarea:focus) {
    border-color: var(--accent-tech-strong);
  }

  :global(.form-checkbox-row) {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 0.92rem;
    color: var(--text-secondary);
  }

  :global(.form-checkbox-row input[type="checkbox"]) {
    width: 1.15rem;
    height: 1.15rem;
    margin-top: 0.2rem;
    accent-color: var(--accent-tech);
  }

  :global(.form-feedback) {
    padding: 1.25rem;
    border-radius: var(--radius-sm);
  }

  :global(.form-feedback-success) {
    border-left: 4px solid var(--success);
    background-color: var(--bg-surface);
  }

  :global(.form-feedback-success h3) {
    margin-bottom: 0.5rem;
    color: var(--success);
  }

  :global(.form-feedback-error) {
    border-left: 4px solid var(--danger);
    background-color: var(--bg-surface);
    color: var(--danger);
  }
</style>

